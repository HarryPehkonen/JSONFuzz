#!/usr/bin/env bash
#
# pre-commit: the FAST tier — the part of the gate that must be seconds, not minutes.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-commit and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# Nothing leaves the machine to make this work: no GitHub, no service, no account.
# It is the same gate a human runs by hand and the nightly clean checkout runs.
#
# Deliberate bypass when you need one:  git commit --no-verify
#
# 2026-10-06 (card t_075c0a6f): the gate IS gate.toml now, run by kit-ci, so this hook NAMES A
# TIER instead of repeating a stage list — the list lives in one place, gate.toml's
# [tier.fast], and a hook that names the tier cannot drift from it. The kit's `tools/ci.sh`
# branch is gone with the file it tested.
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

# C++: a full run is minutes, so commit gets the fast tier — the list gate.toml declares as
# [tier.fast]. Everything else (the sanitizers, fuzz, tidy, the clean-checkout stage) belongs
# to pre-push.
if [ -x "$root/scripts/gate.sh" ]; then
    exec "$root/scripts/gate.sh" --tier fast
fi

# No gate found is a failure, not a warning: a silently unarmed gate is worse than
# no gate, because it looks armed.
printf 'pre-commit: no gate found. Expected %s/scripts/gate.sh (with gate.toml next to it).\n' \
    "$root" >&2
exit 1
