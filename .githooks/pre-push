#!/usr/bin/env bash
#
# pre-push: the FULL tier — the gate, on the tree you are about to publish.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-push and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# This hook is the only caller of the "never publish an uncommitted tree" rule. The old gate
# took it as a flag (`--require-clean`); gate.toml's vocabulary has no per-run flags, so the
# flag became CI_REQUIRE_CLEAN=1 in this hook's environment, which scripts/tree.sh reads. The
# rule itself did not move, and a hand run still gets the full tier without it.
#
# The full tier also proves the COMMITTED tree is complete: the `pristine` stage archives HEAD
# into a temp dir and configures, builds and tests it there.
#
# Deliberate bypass when you need one:  git push --no-verify
#
# 2026-10-06 (card t_075c0a6f): the stage list moved into gate.toml, so this hook names the
# tier. The old hook also ran a `kitprobes` stage; that stage and its probe scripts went with
# the conversion (the closing note in gate.toml has the measurement).
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/scripts/gate.sh" ]; then
    export CI_REQUIRE_CLEAN=1
    exec "$root/scripts/gate.sh" --tier full
fi

printf 'pre-push: no gate found. Expected %s/scripts/gate.sh (with gate.toml next to it).\n' \
    "$root" >&2
exit 1
